# Copy to backend.hcl (git-ignored) and run: terraform init -backend-config=backend.hcl
# The state bucket must exist first (create it once, versioned and private).
bucket       = "your-terraform-state-bucket"
key          = "alibacelonia-portfolio/production.tfstate"
region       = "ap-southeast-1"
encrypt      = true
use_lockfile = true
