# Copy to .env.local for local development. All values are public (inlined into static HTML/JS).

# Canonical site origin, no trailing slash. Single source of truth for canonical URL, sitemap,
# robots, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://alibacelonia.dev

# Contact API endpoint (Terraform output contact_api_endpoint), e.g.
# https://abc123.execute-api.ap-southeast-1.amazonaws.com/contact. Empty: the form says sending
# isn't available.
NEXT_PUBLIC_CONTACT_API_URL=

# Cloudflare Turnstile site key (public). The secret key lives only in AWS SSM.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cal.com booking link without the domain, e.g. alibacelonia/30min. Empty hides the Book a call tab.
NEXT_PUBLIC_CAL_LINK=

# Navigation dock surface: clay (default), glass or neo (neumorphism).
NEXT_PUBLIC_DOCK_STYLE=
