# Copy to .env.local for local development. All values are public (inlined into static HTML/JS).

# Canonical site origin, no trailing slash. Change to https://maba.dev only after that domain is live.
NEXT_PUBLIC_SITE_URL=https://alibacelonia.dev

# Formspree form ID (the part after https://formspree.io/f/). Leave empty to use the mailto fallback.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
